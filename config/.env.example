# Execution
VALIDATION_PARALLEL_WORKERS=5
VALIDATION_WAVE_SIZE=4
VALIDATION_WAVE_PAUSE_SEC=2
VALIDATION_JOB_TIMEOUT_SEC=600
RESULTS_ROOT=results

# Stream baseline
BASELINE_MODE=skip
BASELINE_STORE_DIR=baselines

# Optional MongoDB tenant resolver
MONGO_URI=mongodb://localhost:27017
DB_NAME=validation_platform
TENANT_CONFIG_COLLECTION=tenant_configuration

# Kubernetes (optional — for cluster-mode validation)
K8S_NAMESPACE=validation
VALIDATION_IMAGE=ghcr.io/your-org/validation-platform:latest

# S3 artifact upload (optional)
S3_BUCKET_NAME=validation-artifacts
S3_VALIDATION_PREFIX=post-upgrade-validation
AWS_REGION=us-east-1
